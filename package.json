{
  "name": "pigraphics",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Broadcast graphics engine and coordination service for the Pi Ecosystem: HTML templates, CSS animations, ATEM keying, and live fffleet Fill/Key streaming",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "bin": {
    "pigraphics": "bin/pigraphics.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "fffleet": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "bin",
    "openapi"
  ],
  "pi": {
    "service": "pigraphics",
    "layer": "Layer 2: Media pipeline",
    "displayName": "pigraphics",
    "port": 3201,
    "healthEndpoint": "/health",
    "envPortVar": "PIGRAPHICS_PORT"
  }
}
