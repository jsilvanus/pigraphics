[Unit]
Description=PiGraphics Broadcast Graphics Engine
After=network-online.target pigateway.service

[Service]
WorkingDirectory=%h/apps/pigraphics
EnvironmentFile=%h/apps/pigraphics.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
